# ---------------------------------------------------------------------------
# Copy this file to `.env` on the target machine and fill in the values.
#   cp .env.example .env    # then edit .env
# `.env` is gitignored — it holds the secret token and must NOT be committed.
# ---------------------------------------------------------------------------

# Hugging Face access token. REQUIRED for gated models (Llama-3.x-70B,
# Qwen2.5-72B, etc.). Create one at https://huggingface.co/settings/tokens
# and accept each model's license on its HF page first.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The model to run. Switch models by changing ONLY this line — no code edits.
# The two target models for the scaled-up run (uncensored, multi-GPU):
# MODEL_ID=dphn/dolphin-2.9.2-qwen2-72b
# MODEL_ID=dphn/dolphin-2.9-llama3-70b
# Default keeps the small model for smoke tests:
MODEL_ID=cognitivecomputations/Dolphin3.0-Qwen2.5-3b

# Optional overrides (defaults are usually fine):
# DATA_DIR=/app/storage
# OUT_DIR=/app/outputs
# Limit which GPUs the container uses (default: all). Example: only GPUs 0,1
# CUDA_VISIBLE_DEVICES=0,1
